#!/usr/bin/env bash
set -euo pipefail

# chat — Send and receive messages on an activated identity's trajectory
# Reads TRAJ_DIR + TRAJ_ID from environment (set by `identity shell`).
# Always appends to the root trajectory (ROOT_TRAJ_ID), even when called
# from a forked sub-trajectory (e.g. inside an actor step).
#
# Config file: $CHATRC (default: ./.chatrc)
#   default_send_from=<name>   Default --from for `chat send`

die() { printf 'chat: error: %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Config file (.chatrc)
# ---------------------------------------------------------------------------

CHATRC="${CHATRC:-./.chatrc}"

# Read a key from the chatrc file. Returns empty string if not found.
# Surrounding whitespace is trimmed to match the web server's parsing
# (_chatrc_default_from in web/src/headlong_web/server.py).
_chatrc_get() {
    local key="$1" value
    [[ -f "$CHATRC" ]] || return 0
    value="$(grep "^${key}=" "$CHATRC" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Append to the root trajectory, not the current (possibly forked) one
_chat_append() {
    traj append "${ROOT_TRAJ_ID:-$TRAJ_ID}" >/dev/null
}

# Slack target grammar. This string is a copy of NAME_RE_TEXT in
# slack/src/headlong_slack/naming.py and slack/tests/test_naming.py asserts the
# two are identical, so chat cannot accept a name the bridge would drop (the
# bridge dropped 23 of Audel's 74 sends in one week with no error, 2026-09-09;
# design/outbound_delivery.md). Edit both or CI fails.
_SLACK_NAME_RE='^slack-([UW][A-Z0-9]+|[CGD][A-Z0-9]+|[A-Za-z0-9]+-[A-Za-z0-9]+(-[0-9.]+)?)$'

# _check_target <name>: a name that claims to be Slack must be one the bridge
# can deliver. Other transports' names pass through untouched.
_check_target() {
    local name="$1"
    [[ "$name" == slack-* ]] || return 0
    [[ "$name" =~ $_SLACK_NAME_RE ]] && return 0
    die "cannot deliver to '$name': not a Slack address the bridge understands.
Accepted forms:
  slack-<user>-<channel>-<thread ts>   reply in a channel thread (copy the sender's name verbatim)
  slack-<user>-<channel>               a DM, or a channel top-level
  slack-C<id>                          post top-level in a channel (e.g. slack-C0BMVH6LM4K)
  slack-U<id>                          DM a person (e.g. slack-U0BFD9NDVE3)
Slack ids are uppercase: users start with U, channels with C."
}

# Handle --help before env var check
case "${1:-}" in -h|--help|help) ;; *)
    [[ -n "${TRAJ_DIR:-}" ]] || die "TRAJ_DIR not set. Run: identity shell <name>"
    [[ -n "${TRAJ_ID:-}" ]] || die "TRAJ_ID not set. Run: identity shell <name>"
    ;; esac

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

# Default --from from .chatrc; require --to (pre-filled from IDENTITY_NAME).
# Reads/writes the caller's `from` and `to` locals via dynamic scoping.
_resolve_from_to() {
    if [[ -z "$from" ]]; then
        from=$(_chatrc_get "default_send_from")
        if [[ -z "$from" ]]; then
            die "No --from specified and no default_send_from in $CHATRC.
Create a .chatrc file with:
  mkdir -p \$(dirname $CHATRC) && echo 'default_send_from=your-name' > $CHATRC"
        fi
    fi
    if [[ -z "$to" ]]; then
        die "No --to specified and IDENTITY_NAME not set."
    fi
}

cmd_send() {
    local message="" from="" to="${IDENTITY_NAME:-}" source_url="" force=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from) from="${2:?--from requires a name}"; shift 2 ;;
            --to)   to="${2:?--to requires a name}"; shift 2 ;;
            --source-url) source_url="${2:?--source-url requires a URL}"; shift 2 ;;
            --force) force=1; shift ;;
            *)      message="${message:+$message }$1"; shift ;;
        esac
    done

    # Read from stdin if no args and stdin is piped
    if [[ -z "$message" && ! -t 0 ]]; then
        message=$(cat)
    fi
    [[ -z "$message" ]] && die "No message provided. Usage: chat send [--from <name>] [--to <name>] <message>"

    _resolve_from_to
    _check_target "$to"

    # A self-addressed message re-triggers the identity's own message
    # subscriptions, which can loop it into replying to itself forever.
    # `chat send` with no --to targets the identity, so an agent using it to
    # 'send' ends up messaging itself — the correct tool is `chat reply`.
    [[ "$from" == "$to" ]] && die "refusing to send a message from '$from' to itself.
To message someone else: chat reply <their-name> <message>
To keep a note for yourself, append a thought step instead of a message."

    [[ "$force" -eq 1 ]] || _refuse_repeat "$from" "$to" "$message"

    # source_url records where a bridged message came from. It is optional
    # metadata for operators and never affects routing or model context.
    printf '%s' "$message" \
        | jq -Rsc \
        --arg from "$from" \
        --arg to "$to" \
        --arg source_url "$source_url" \
        '{type:"message", content:., from:$from, to:$to, source:"chat"}
         + (if $source_url == "" then {} else {source_url:$source_url} end)' \
        | _chat_append

    printf 'Message sent.\n' >&2
}

cmd_reply() {
    local reply_to="" follow_up=0 force=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --reply-to) reply_to="${2:?--reply-to requires a step id}"; shift 2 ;;
            # A deliberate second reply to a message we already answered: the
            # responder said "let me look into that", the mind did the work,
            # and this delivers the result. Stamps reply_to like any reply
            # but skips the answered guard below, which exists for races,
            # not for follow-ups (design/conversation_memory.md, part 5).
            --follow-up) follow_up=1; shift ;;
            --force) force=1; shift ;;
            *) break ;;
        esac
    done
    local to_name="${1:-}"
    [[ -z "$to_name" ]] && die "Usage: chat reply [--reply-to <step_id>] <to_name> [message]"
    shift
    _check_target "$to_name"

    local message=""
    while [[ $# -gt 0 ]]; do
        message="${message:+$message }$1"; shift
    done
    if [[ -z "$message" && ! -t 0 ]]; then
        message=$(cat)
    fi
    [[ -z "$message" ]] && die "No message provided. Usage: chat reply <to_name> <message>"

    local from="${IDENTITY_NAME:-}"
    [[ -z "$from" ]] && die "IDENTITY_NAME not set. Run: identity shell <name>"

    # Replying to yourself loops your own message subscriptions (see cmd_send).
    [[ "$to_name" == "$from" ]] && die "refusing to reply to yourself ('$from').
Use the name of the person you mean to reach: chat reply <their-name> <message>"

    # A reply answers something. When the caller doesn't say what (--reply-to),
    # infer it: the latest message FROM the recipient TO us that no stamped
    # reply has answered yet. Stamping here, at the transport, keeps "has this
    # message been answered" a fact in the log no matter which path (or model)
    # sent the reply. A reply that answers nothing (every inbound already
    # answered) stays unstamped.
    if [[ -z "$reply_to" ]]; then
        reply_to=$(timeout 10 traj cat "${ROOT_TRAJ_ID:-$TRAJ_ID}" --raw 2>/dev/null \
            | timeout 10 jq -Rrn --arg me "$from" --arg them "$to_name" '
                [inputs | fromjson? // empty] as $steps
                | [$steps[] | select(.type == "message" and .from == $me
                                     and (.reply_to // "") != "") | .reply_to] as $answered
                | [$steps[]
                   | select(.type == "message" and .from == $them and .to == $me)
                   | .step_id // "" | select(. != "")
                   | select(. as $id | $answered | index($id) | not)]
                | last // ""' 2>/dev/null) || reply_to=""
    fi

    # A reply that answers nothing (no inbound to stamp) is a proactive send
    # into the conversation, and gets the same repeat check as `chat send`.
    # A reply stamped to a specific inbound is an answer, and two people (or
    # one person twice) may deserve the same answer, so those are exempt.
    if [[ -z "$reply_to" && "$force" -eq 0 ]]; then
        _refuse_repeat "$from" "$to_name" "$message"
    fi

    # Answered guard: if a reply from us stamped to this step is already in
    # the log, don't send another. Several thinkers subscribe to message
    # steps, so concurrent wakes for one inbound can each try to answer it
    # (2026-08-17: one "you there?" got three replies). First send wins;
    # bounded to the recent log — duplicates happen within seconds.
    if [[ -n "$reply_to" && "$follow_up" -eq 0 ]]; then
        local _guard_tf _dup
        _guard_tf=$(traj path "${ROOT_TRAJ_ID:-$TRAJ_ID}" 2>/dev/null) || _guard_tf=""
        if [[ -n "$_guard_tf" && -f "$_guard_tf" ]]; then
            _dup=$(tail -n 2000 -- "$_guard_tf" 2>/dev/null \
                | jq -Rr --arg me "$from" --arg rt "$reply_to" \
                    'fromjson? // empty
                     | select(.type == "message" and .from == $me
                              and (.reply_to // "") == $rt)
                     | .step_id // "answered"' 2>/dev/null | head -1) || _dup=""
            if [[ -n "$_dup" ]]; then
                printf 'chat: step %s already has a reply from %s — skipping duplicate send.\n' \
                    "$reply_to" "$from" >&2
                return 0
            fi
        fi
    fi

    # reply_to stamps which message step this reply answers, making "has this
    # message been answered" a fact in the log rather than an ordering
    # heuristic. Additive — readers that don't know it ignore it.
    printf '%s' "$message" \
        | jq -Rsc \
        --arg from "$from" \
        --arg to "$to_name" \
        --arg reply_to "$reply_to" \
        --argjson follow_up "$follow_up" \
        '{type:"message", content:., from:$from, to:$to, source:"chat"}
         + (if $reply_to == "" then {} else {reply_to:$reply_to} end)
         + (if $follow_up == 1 then {follow_up:true} else {} end)' \
        | _chat_append

    printf 'Reply sent.\n' >&2
}

cmd_send_file() {
    local from="" to="${IDENTITY_NAME:-}" filepath=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from) from="${2:?--from requires a name}"; shift 2 ;;
            --to)   to="${2:?--to requires a name}"; shift 2 ;;
            *)      filepath="$1"; shift ;;
        esac
    done
    [[ -z "$filepath" ]] && die "Usage: chat send-file [--from <name>] [--to <name>] <filename>"
    [[ -f "$filepath" ]] || die "File not found: $filepath"
    _check_target "$to"

    local size max
    size=$(stat -c%s "$filepath" 2>/dev/null || wc -c < "$filepath")
    size=${size//[[:space:]]/}
    max="${CHAT_SEND_FILE_MAX_BYTES:-10485760}"
    [[ "$max" =~ ^[0-9]+$ ]] || die "CHAT_SEND_FILE_MAX_BYTES must be an integer"
    if (( size == 0 )); then
        die "empty file: $filepath"
    fi
    if (( size > max )); then
        die "file too large: $filepath ($size bytes; max $max)"
    fi

    _resolve_from_to

    local filename
    filename=$(basename "$filepath")
    # Binary-safe: JSON cannot hold raw bytes, so stamp standard base64
    # via a temp file (never argv). Text files also keep their body in
    # `content` so Slack and web chat still deliver the file text; binary
    # files use a short marker because `content` cannot hold raw bytes.
    local b64tmp
    b64tmp=$(mktemp) || die "mktemp failed"
    if ! base64 -w 0 < "$filepath" | tr -d '\n' > "$b64tmp"; then
        rm -f "$b64tmp"
        die "failed to encode $filepath"
    fi

    local jq_rc=0
    if _chat_is_text_file "$filepath"; then
        jq -nc \
            --arg filename "$filename" \
            --arg from "$from" \
            --arg to "$to" \
            --rawfile content "$filepath" \
            --rawfile content_b64 "$b64tmp" \
            '{type:"message", content:($content | sub("\n+$";"")), filename:$filename, content_b64:$content_b64, from:$from, to:$to, source:"chat"}' \
            | _chat_append || jq_rc=$?
    else
        jq -nc \
            --arg filename "$filename" \
            --arg content "[file: $filename]" \
            --arg from "$from" \
            --arg to "$to" \
            --rawfile content_b64 "$b64tmp" \
            '{type:"message", content:$content, filename:$filename, content_b64:$content_b64, from:$from, to:$to, source:"chat"}' \
            | _chat_append || jq_rc=$?
    fi
    rm -f "$b64tmp"
    [[ "$jq_rc" -eq 0 ]] || die "failed to encode/append $filepath"

    printf 'File sent: %s\n' "$filename" >&2
}

cmd_react() {
    local from="${IDENTITY_NAME:-}" to="" reply_to="" source_url="" emoji=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from) from="${2:?--from requires a name}"; shift 2 ;;
            --to)   to="${2:?--to requires a name}"; shift 2 ;;
            --reply-to) reply_to="${2:?--reply-to requires a step id}"; shift 2 ;;
            --source-url) source_url="${2:?--source-url requires a URL}"; shift 2 ;;
            *) break ;;
        esac
    done
    if [[ -z "$to" && $# -gt 0 ]]; then
        to="$1"; shift
    fi
    [[ -z "$to" ]] && die "Usage: chat react [--reply-to <step_id>] [--source-url <url>] <to_name> <emoji>"
    _check_target "$to"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from) from="${2:?--from requires a name}"; shift 2 ;;
            --to)   to="${2:?--to requires a name}"; shift 2 ;;
            --reply-to) reply_to="${2:?--reply-to requires a step id}"; shift 2 ;;
            --source-url) source_url="${2:?--source-url requires a URL}"; shift 2 ;;
            *) break ;;
        esac
    done
    emoji="${1:-}"
    [[ -z "$emoji" ]] && die "Usage: chat react [--reply-to <step_id>] [--source-url <url>] <to_name> <emoji>"
    shift
    [[ $# -eq 0 ]] || die "unexpected extra arguments"

    # Slack reactions.add wants the short name (thumbsup), not :thumbsup: or 👍.
    emoji="${emoji#:}"
    emoji="${emoji%:}"
    [[ "$emoji" =~ ^[-a-z0-9_+:]{1,64}$ ]] || die "invalid Slack emoji name: $emoji"

    _resolve_from_to

    if [[ -z "$source_url" && -n "$reply_to" ]]; then
        source_url=$(
            traj show --traj_dir "$TRAJ_DIR" "$reply_to" --field source_url 2>/dev/null \
                | tr -d '\n'
        ) || true
    fi

    jq -nc \
        --arg from "$from" \
        --arg to "$to" \
        --arg reaction "$emoji" \
        --arg reply_to "$reply_to" \
        --arg source_url "$source_url" \
        '{type:"message", content:(":" + $reaction + ":"), reaction:$reaction, from:$from, to:$to, source:"chat"}
         + (if $reply_to == "" then {} else {reply_to:$reply_to} end)
         + (if $source_url == "" then {} else {source_url:$source_url} end)' \
        | _chat_append

    printf 'Reaction sent: :%s:\n' "$emoji" >&2
}

# UTF-8, no NUL: the historical `content=$(cat ...)` shape Slack/web still read.
# JSON strings cannot hold NUL; jq --rawfile requires UTF-8.
_chat_is_text_file() {
    local f="$1" n stripped
    n=$(wc -c < "$f")
    n=${n//[[:space:]]/}
    stripped=$(tr -d '\0' < "$f" | wc -c)
    stripped=${stripped//[[:space:]]/}
    [[ "$n" -eq "$stripped" ]] || return 1
    if command -v iconv >/dev/null 2>&1; then
        iconv -f UTF-8 -t UTF-8 "$f" >/dev/null 2>&1 || return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Person keys (design/conversation_memory.md, part 2)
# ---------------------------------------------------------------------------
# The chat `from` name is a ROUTING name: a bridge packs everything it needs
# to deliver the reply into it, so one human is many names (a Slack user is a
# new name in every channel thread). The person key is what stays stable:
#   slack-U07AB-C09XYZ-1722400000.123456  ->  slack:U07AB
#   slack-U07AB-D09XYZ                    ->  slack:U07AB
#   telegram-8525624593-8525624593        ->  telegram:8525624593
#   pwa-andy                              ->  pwa:andy
#   Andy                                  ->  Andy
# The same rule lives in jq below (_PERSON_KEY_JQ) so the index filter can
# apply it per line; keep the two in step.
# The thread key is the other axis: which conversation a message sits in,
# whoever sent it. Only Slack channel threads have one (channel + thread ts);
# a DM, the phone chat, and Telegram are one person deep, so they get none.
#   slack-U07AB-C09XYZ-1722400000.123456  ->  slack-thread:C09XYZ-1722400000.123456
_PERSON_KEY_JQ='def person_key:
    if test("^slack-[A-Za-z0-9]+-[A-Za-z0-9]+(-[0-9.]+)?$") then "slack:" + (split("-")[1])
    elif test("^telegram-[0-9]+-[0-9]+$") then "telegram:" + (split("-")[1])
    elif test("^pwa-.") then "pwa:" + .[4:]
    else . end;
  def thread_key:
    if test("^slack-[A-Za-z0-9]+-[A-Za-z0-9]+-[0-9.]+$") then "slack-thread:" + (split("-")[2:] | join("-"))
    else "" end;'

_person_key() {
    printf '%s' "$1" | jq -Rr "$_PERSON_KEY_JQ person_key"
}
_thread_key() {
    printf '%s' "$1" | jq -Rr "$_PERSON_KEY_JQ thread_key"
}

# All keys that mean the same person: the key itself plus any `aliases` listed
# in a `type: person` memory whose `person_key` matches (or whose own key is
# listed as an alias). Reads $MEM_DIR; silent when unset. One key per line.
_person_aliases() {
    local key="$1" f ftype fkey aliases
    printf '%s\n' "$key"
    [[ -n "${MEM_DIR:-}" && -d "$MEM_DIR" ]] || return 0
    for f in "$MEM_DIR"/*.md; do
        [[ -f "$f" ]] || continue
        ftype=$(awk 'NR==1 && /^---$/{f=1; next} f && /^---$/{exit} f && /^type:/{sub(/^type:[[:space:]]*/, ""); print; exit}' "$f")
        [[ "$ftype" == person ]] || continue
        fkey=$(awk 'NR==1 && /^---$/{f=1; next} f && /^---$/{exit} f && /^person_key:/{sub(/^person_key:[[:space:]]*/, ""); print; exit}' "$f")
        # aliases: [a, b]  or  aliases:\n  - a\n  - b
        aliases=$(awk 'NR==1 && /^---$/{f=1; next} f && /^---$/{exit}
            f && /^aliases:[[:space:]]*\[/ {s=$0; sub(/^aliases:[[:space:]]*\[/, "", s); sub(/\].*$/, "", s); gsub(/,/, "\n", s); print s; next}
            f && /^aliases:[[:space:]]*$/ {a=1; next}
            f && a && /^[[:space:]]*-[[:space:]]*/ {sub(/^[[:space:]]*-[[:space:]]*/, ""); print; next}
            f && a {a=0}' "$f" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^"//;s/"$//' | sed '/^$/d')
        if [[ "$fkey" == "$key" ]] || printf '%s\n' "$aliases" | grep -qx -- "$key"; then
            [[ -n "$fkey" ]] && printf '%s\n' "$fkey"
            [[ -n "$aliases" ]] && printf '%s\n' "$aliases"
        fi
    done | sort -u
}

# ---------------------------------------------------------------------------
# Message index (design/conversation_memory.md, part 1)
# ---------------------------------------------------------------------------
# messages.jsonl next to the trajectory holds every message step, one slim
# line each. It is DERIVED: the trajectory stays the only truth, and the index
# is rebuilt from it whenever it is missing or does not match. It maintains
# itself on read: each call appends the message lines from the bytes the
# trajectory gained since the recorded offset (usually a few MB), so nothing
# that writes messages has to know it exists, and a busy identity does not pay
# a whole-file scan on every reply (a 5,000 line tail was 1.3s and could not
# see past ~a day; the full file is over 1GB on Audel).
#
# deferrals.jsonl beside it is built in the same pass and shares the offset
# file: the responder's deferral `action` steps (source responder, with a
# trigger_step, person, request) and every observation that carries
# `resolves=<trigger>`. `chat pending` reads it so the mind sees every
# unresolved request however old, not just the ones still inside its
# recent-stream window (design/conversation_memory.md, part 5: on 2026-09-02
# a request was masked by a newer one, then aged out of the window unseen).
_INDEX_CONTENT_CAP=8000

_deferrals_path() { printf '%s/deferrals.jsonl' "$(dirname "$1")"; }
# deliveries.jsonl, also built in the same pass: every `delivery` step a
# bridge wrote back for one of our outbound messages (design/outbound_delivery.md).
# `chat sent` joins it to messages.jsonl by trigger_step to show whether a send
# was delivered, failed, or is still unconfirmed.
_deliveries_path() { printf '%s/deliveries.jsonl' "$(dirname "$1")"; }

# _index_update <trajectory file> <index file>
# Brings the index up to date. Only complete lines are consumed: a line still
# being appended is left for the next call, so a message is never skipped.
_index_update() {
    local tf="$1" idx="$2" off="$2.offset" lock="$2.lock"
    local header have_off have_header size
    header=$(head -n 1 -- "$tf" 2>/dev/null | jq -r '.step_id // .traj_id // ""' 2>/dev/null) || header=""
    have_off=0; have_header=""
    if [[ -f "$off" ]]; then
        read -r have_off have_header < "$off" || true
        [[ "$have_off" =~ ^[0-9]+$ ]] || have_off=0
    fi
    local dfr dlv; dfr=$(_deferrals_path "$idx"); dlv=$(_deliveries_path "$idx")
    if [[ ! -f "$idx" || ! -f "$dfr" || ! -f "$dlv" || "$have_header" != "$header" ]]; then
        have_off=0
        : > "$idx.rebuild" || return 1
        mv -f "$idx.rebuild" "$idx"
        : > "$dfr.rebuild" || return 1
        mv -f "$dfr.rebuild" "$dfr"
        : > "$dlv.rebuild" || return 1
        mv -f "$dlv.rebuild" "$dlv"
    fi
    size=$(wc -c < "$tf" | tr -d ' ')
    (( size > have_off )) || return 0
    # One updater at a time; a concurrent reader just uses what is there.
    mkdir "$lock" 2>/dev/null || return 0
    _index_apply "$tf" "$idx" "$off" "$header" "$have_off"
    local rc=$?
    rmdir "$lock" 2>/dev/null
    return $rc
}

# The locked part of _index_update: read the new bytes, index the complete
# message lines among them, advance the offset.
_index_apply() {
    local tf="$1" idx="$2" off="$3" header="$4" have_off="$5"
    local new_bytes tmp partial
    tmp=$(mktemp) || return 1
    tail -c +"$((have_off + 1))" -- "$tf" > "$tmp"
    new_bytes=$(wc -c < "$tmp" | tr -d ' ')
    partial=0
    if [[ "$new_bytes" -gt 0 && "$(tail -c 1 "$tmp" | wc -l | tr -d ' ')" -eq 0 ]]; then
        partial=$(tail -n 1 "$tmp" | wc -c | tr -d ' ')
    fi
    if (( new_bytes - partial > 0 )); then
        head -c "$((new_bytes - partial))" "$tmp" \
            | grep -F '"type":"message"' \
            | jq -c --argjson cap "$_INDEX_CONTENT_CAP" 'fromjson? // empty
                | select(.type == "message" and (.from // "") != "" and (.to // "") != "")
                | {step_id, ts, from, to, reply_to, filename,
                   content: ((.content // "") | tostring
                             | if length > $cap then .[0:$cap] + "…[truncated]" else . end)}
                | with_entries(select(.value != null))' -R >> "$idx" 2>/dev/null || true
        head -c "$((new_bytes - partial))" "$tmp" \
            | grep -F -e '"trigger_step"' -e '"resolves":' \
            | jq -c --argjson cap "$_INDEX_CONTENT_CAP" 'fromjson? // empty
                | if .type == "action" and .source == "responder" and (.trigger_step // "") != "" then
                    {kind: "request", step_id, ts, trigger_step, person,
                     request: ((.request // .content // "") | tostring
                               | if length > $cap then .[0:$cap] + "…[truncated]" else . end)}
                  elif .type == "observation" and (.resolves // "") != "" then
                    {kind: "resolve", step_id, ts, resolves}
                  else empty end
                | with_entries(select(.value != null))' -R >> "$(_deferrals_path "$idx")" 2>/dev/null || true
        head -c "$((new_bytes - partial))" "$tmp" \
            | grep -F '"type":"delivery"' \
            | jq -c 'fromjson? // empty
                | select(.type == "delivery" and (.trigger_step // "") != "")
                | {step_id, ts, trigger_step, status, transport, reason, permalink, channel}
                | with_entries(select(.value != null))' -R >> "$(_deliveries_path "$idx")" 2>/dev/null || true
    fi
    printf '%s %s\n' "$((have_off + new_bytes - partial))" "$header" > "$off"
    rm -f "$tmp"
}

# Parse "7d" / "36h" / "90m" / "3600" (seconds) into seconds.
_duration_s() {
    case "$1" in
        *d) printf '%s' "$(( ${1%d} * 86400 ))" ;;
        *h) printf '%s' "$(( ${1%h} * 3600 ))" ;;
        *m) printf '%s' "$(( ${1%m} * 60 ))" ;;
        *s) printf '%s' "${1%s}" ;;
        *)  printf '%s' "$1" ;;
    esac
}

cmd_history() {
    local n=20 with="" thread="" since="" as_json=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --with)  with="${2:?--with requires a name or person key}"; shift 2 ;;
            --thread) thread="${2:?--thread requires a routing name or thread key}"; shift 2 ;;
            --since) since="${2:?--since requires a duration like 7d}"; shift 2 ;;
            -n)      n="${2:?-n requires a count}"; shift 2 ;;
            --json)  as_json=1; shift ;;
            *)       n="$1"; shift ;;
        esac
    done
    [[ "$n" =~ ^[0-9]+$ ]] || die "history: count must be a number, got '$n'"

    local identity_name="${IDENTITY_NAME:-agent}"

    if [[ -n "$with" || -n "$thread" ]]; then
        # Indexed path. --with: this person's conversation with us, grouped by
        # person key across every routing name they have used. --thread: every
        # message in one Slack thread, whoever sent it (their messages to us
        # and our replies to anyone there). Both: the union. Newest last.
        local tf idx key keys_json tkey since_s
        tf=$(traj path "${ROOT_TRAJ_ID:-$TRAJ_ID}" 2>/dev/null) || tf=""
        [[ -n "$tf" && -f "$tf" ]] || die "history: cannot resolve the root trajectory file"
        idx="$(dirname "$tf")/messages.jsonl"
        _index_update "$tf" "$idx" || true
        [[ -f "$idx" ]] || { [[ $as_json -eq 1 ]] && printf '[]\n'; return 0; }
        keys_json='[]'
        if [[ -n "$with" ]]; then
            key=$(_person_key "$with")
            keys_json=$(_person_aliases "$key" | jq -Rn '[inputs | select(length > 0)]')
        fi
        tkey=""
        if [[ -n "$thread" ]]; then
            case "$thread" in
                slack-thread:*) tkey="$thread" ;;
                *) tkey=$(_thread_key "$thread") ;;
            esac
            if [[ -z "$tkey" && -z "$with" ]]; then
                [[ $as_json -eq 1 ]] && printf '[]\n'
                return 0   # not a threaded conversation: nothing to add
            fi
        fi
        since_s=0
        [[ -n "$since" ]] && since_s=$(_duration_s "$since")
        jq -cn --arg me "$identity_name" --argjson keys "$keys_json" --arg tkey "$tkey" \
               --argjson since "$since_s" --argjson n "$n" --argjson json "$as_json" "$_PERSON_KEY_JQ"'
            def secs: (.ts // "")[0:19] + "Z" | try fromdateiso8601 catch 0;
            def with_person:
                (.from == $me and ((.to | person_key) as $k | $keys | index($k)) != null)
                or (.to == $me and ((.from | person_key) as $k | $keys | index($k)) != null);
            def in_thread:
                $tkey != "" and ((.from | thread_key) == $tkey or (.to | thread_key) == $tkey);
            [inputs | fromjson? // empty]
            | unique_by(.step_id)
            | map(select((with_person or in_thread)
                         and ($since == 0 or (secs >= (now - $since)))))
            | sort_by(.ts // "")
            | .[-$n:]
            | if $json == 1 then . else
                .[] | "\(.ts // "?") \(.from) → \(.to): \(.content)"
              end' -R < "$idx"
        return 0
    fi

    # Support both new "message" type and legacy "human-msg"/"agent-msg" types
    traj cat "${ROOT_TRAJ_ID:-$TRAJ_ID}" --filter type=message,human-msg,agent-msg --raw 2>/dev/null \
    | tail -n "$n" \
    | while IFS= read -r line; do
        local step_type content msg_from msg_to
        step_type=$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null)
        content=$(printf '%s' "$line" | jq -r '.content // empty' 2>/dev/null)
        [[ -z "$content" ]] && continue
        case "$step_type" in
            message)
                msg_from=$(printf '%s' "$line" | jq -r '.from // "unknown"' 2>/dev/null)
                msg_to=$(printf '%s' "$line" | jq -r '.to // empty' 2>/dev/null)
                printf '%s → %s: %s\n' "$msg_from" "${msg_to:-?}" "$content"
                ;;
            human-msg)
                msg_from=$(printf '%s' "$line" | jq -r '.from // empty' 2>/dev/null)
                printf '%s: %s\n' "${msg_from:-you}" "$content"
                ;;
            agent-msg)
                printf '%s: %s\n' "$identity_name" "$content"
                ;;
        esac
    done
}

# chat pending [--max-age 14d] [--json]
# Every deferral the responder handed the mind that no observation has
# resolved yet, oldest first. Text lines by default; --json is an array of
# {trigger_step, person, request, ts, age_s}. --max-age drops requests older
# than that (default: none), so a request never resolved does not nag forever.
cmd_pending() {
    local max_age="" as_json=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --max-age) max_age="${2:?--max-age requires a duration like 14d}"; shift 2 ;;
            --json)    as_json=1; shift ;;
            *)         die "pending: unknown argument '$1'" ;;
        esac
    done
    local tf idx dfr max_s
    tf=$(traj path "${ROOT_TRAJ_ID:-$TRAJ_ID}" 2>/dev/null) || tf=""
    [[ -n "$tf" && -f "$tf" ]] || die "pending: cannot resolve the root trajectory file"
    idx="$(dirname "$tf")/messages.jsonl"
    _index_update "$tf" "$idx" || true
    dfr=$(_deferrals_path "$idx")
    [[ -f "$dfr" ]] || { [[ $as_json -eq 1 ]] && printf '[]\n'; return 0; }
    max_s=0
    [[ -n "$max_age" ]] && max_s=$(_duration_s "$max_age")
    jq -rcn --argjson max "$max_s" --argjson json "$as_json" '
        def secs: (.ts // "")[0:19] + "Z" | try fromdateiso8601 catch 0;
        def age_text: if . < 3600 then "\(. / 60 | floor)m"
                      elif . < 86400 then "\(. / 3600 | floor)h"
                      else "\(. / 86400 | floor)d" end;
        [inputs | fromjson? // empty] as $all
        | ($all | map(select(.kind == "resolve") | .resolves)) as $done
        | $all
        | map(select(.kind == "request" and (.trigger_step as $t | $done | index($t) | not)))
        | unique_by(.trigger_step)
        | map(. + {age_s: ((now - secs) | floor)})
        | map(select($max == 0 or .age_s <= $max))
        | sort_by(.ts // "")
        | if $json == 1 then map({trigger_step, person, request, ts, age_s})
          else .[] | "\(.ts // "?") \(.person // "someone"): \(.request) (pending \(.age_s | age_text), trigger \(.trigger_step))"
          end' -R < "$dfr"
}

# chat sent [--since 24h] [-n N] [--json]
# The identity's outbound messages, newest first, each with what the bridge
# reported back: delivered, failed (with the reason), skipped, pending (a
# transport that confirms deliveries has not yet), or unconfirmed (a transport
# with no delivery notices, e.g. the phone chat). This is the sent folder the
# mind checks before sending again (design/outbound_delivery.md, part 5).
_SENT_CONFIRMING_RE='^(slack|telegram)-'
cmd_sent() {
    local since="" n=50 as_json=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --since) since="${2:?--since requires a duration like 24h}"; shift 2 ;;
            -n)      n="${2:?-n requires a count}"; shift 2 ;;
            --json)  as_json=1; shift ;;
            *)       die "sent: unknown argument '$1'" ;;
        esac
    done
    [[ "$n" =~ ^[0-9]+$ ]] || die "sent: count must be a number, got '$n'"
    local me="${IDENTITY_NAME:-agent}" tf idx dlv since_s
    tf=$(traj path "${ROOT_TRAJ_ID:-$TRAJ_ID}" 2>/dev/null) || tf=""
    [[ -n "$tf" && -f "$tf" ]] || die "sent: cannot resolve the root trajectory file"
    idx="$(dirname "$tf")/messages.jsonl"
    _index_update "$tf" "$idx" || true
    dlv=$(_deliveries_path "$idx")
    [[ -f "$idx" ]] || { [[ $as_json -eq 1 ]] && printf '[]\n'; return 0; }
    [[ -f "$dlv" ]] || : > "$dlv"
    since_s=0
    [[ -n "$since" ]] && since_s=$(_duration_s "$since")
    jq -rcn --arg me "$me" --argjson since "$since_s" --argjson n "$n" --argjson json "$as_json" \
           --arg confirming "$_SENT_CONFIRMING_RE" --slurpfile dlv "$dlv" '
        def secs: (.ts // "")[0:19] + "Z" | try fromdateiso8601 catch 0;
        def age_text: if . < 3600 then "\(. / 60 | floor)m"
                      elif . < 86400 then "\(. / 3600 | floor)h"
                      else "\(. / 86400 | floor)d" end;
        # the newest notice per message wins (a replayed step may write two)
        ($dlv | map(select((.trigger_step // "") != ""))
              | group_by(.trigger_step)
              | map({key: .[0].trigger_step, value: (sort_by(.ts // "") | last)})
              | from_entries) as $d
        | [inputs | fromjson? // empty]
        | unique_by(.step_id)
        | map(select(.from == $me and ($since == 0 or secs >= (now - $since))))
        | sort_by(.ts // "") | reverse | .[:$n]
        | map(. as $m | ($d[$m.step_id] // {}) as $n
              | $m + {age_s: ((now - ($m | secs)) | floor),
                      state: ($n.status // (if ($m.to | test($confirming)) then "pending" else "unconfirmed" end)),
                      reason: $n.reason, permalink: $n.permalink, transport: $n.transport}
              | with_entries(select(.value != null)))
        | if $json == 1 then map({step_id, ts, to, content, state, reason, permalink, transport, age_s, reply_to, filename})
          else .[] | "\(.ts // "?") \(.to)  \(.state)"
                     + (if .state == "pending" then " \(.age_s | age_text)" else "" end)
                     + (if .reason then " (\(.reason))" else "" end)
                     + "  " + ((.filename // .content // "") | gsub("\n"; " ") | if length > 80 then .[0:80] + "…" else . end)
          end' -R < "$idx"
}

# _refuse_repeat <from> <to> <message>: die if this exact message already went
# to this destination inside CHAT_REPEAT_WINDOW (default 24h). The check the
# mind failed to make on 2026-09-08 (four sends of the same two papers) now
# lives in the tool; `--force` overrides it (design/outbound_delivery.md, part 6).
_refuse_repeat() {
    local from="$1" to="$2" message="$3" tf idx window_s hit
    tf=$(traj path "${ROOT_TRAJ_ID:-$TRAJ_ID}" 2>/dev/null) || return 0
    [[ -n "$tf" && -f "$tf" ]] || return 0
    idx="$(dirname "$tf")/messages.jsonl"
    _index_update "$tf" "$idx" || true
    [[ -f "$idx" ]] || return 0
    window_s=$(_duration_s "${CHAT_REPEAT_WINDOW:-24h}")
    [[ "$window_s" =~ ^[0-9]+$ && "$window_s" -gt 0 ]] || return 0
    local msg_file; msg_file=$(mktemp) || return 0
    printf '%s' "$message" > "$msg_file"
    hit=$(jq -rn --arg me "$from" --arg to "$to" --argjson w "$window_s" --argjson cap "$_INDEX_CONTENT_CAP" \
              --rawfile msg "$msg_file" '
        def secs: (.ts // "")[0:19] + "Z" | try fromdateiso8601 catch 0;
        ($msg | if length > $cap then .[0:$cap] + "…[truncated]" else . end) as $want
        | [inputs | fromjson? // empty
           | select(.from == $me and .to == $to and (.content // "") == $want and secs >= (now - $w))]
        | sort_by(.ts // "") | last // empty
        | "\(.ts) \(.step_id)"' -R < "$idx" 2>/dev/null) || hit=""
    rm -f "$msg_file"
    [[ -z "$hit" ]] && return 0
    die "refusing to send: this exact message already went to '$to' at ${hit% *} (step ${hit#* }).
\`chat sent\` shows recent sends and whether each was delivered. If the repeat is deliberate, add --force."
}

cmd_person_key() {
    [[ -n "${1:-}" ]] || die "Usage: chat person-key <name>"
    _person_key "$1"; echo
}
cmd_thread_key() {
    [[ -n "${1:-}" ]] || die "Usage: chat thread-key <name>"
    _thread_key "$1"; echo
}

cmd_repl() {
    # Prefer the renamed TUI binary; fall back to a pre-rename build.
    if command -v headlong-tui >/dev/null 2>&1; then
        exec headlong-tui "$@"
    fi
    exec shellm-tui "$@"
}

usage() {
    cat <<'EOF'
chat — Messaging for an activated identity

Usage:
  chat send [--from <name>] [--to <name>] [--source-url <url>] [--force] <message>
                             Send a message (from defaults to .chatrc
                             default_send_from, to defaults to $IDENTITY_NAME).
                             Refuses a message identical to one sent to the
                             same destination in the last 24h
                             (CHAT_REPEAT_WINDOW) unless --force.
                             A slack-* destination must be a form the bridge
                             delivers: slack-<user>-<channel>[-<ts>],
                             slack-C<id> (channel), or slack-U<id> (DM)
  chat send-file [--from <name>] [--to <name>] <file>
                             Send a file's contents as a message
  chat react [--reply-to <step_id>] [--source-url <url>] <to_name> <emoji>
                             Add a Slack emoji reaction (name, not unicode).
                             Stamps reaction on a chat-sourced message step.
  chat reply [--reply-to <step_id>] [--follow-up] [--force] <to_name> <message>
                             Agent sends a reply (from is $IDENTITY_NAME).
                             Stamps reply_to with the step it answers —
                             inferred (latest unanswered message from
                             <to_name>) unless --reply-to overrides.
                             --follow-up: a deliberate second reply to an
                             already answered message (delivering work the
                             first reply promised); skips the duplicate
                             guard and marks the step follow_up:true.
                             --force: send even if the same text already
                             went to <to_name> in the last 24h (only a
                             reply that answers no specific inbound is
                             checked; answers are exempt).
  chat sent [--since 24h] [-n N] [--json]
                             Outbound messages, newest first, with what the
                             bridge reported back: delivered, failed (with
                             the reason), skipped, pending (no confirmation
                             yet from a bridge that sends them), or
                             unconfirmed (a transport that never does).
                             From deliveries.jsonl beside messages.jsonl
  chat history [N]           Show last N messages (default 20)
  chat history --with <name> [--since 7d] [-n N] [--json]
                             This person's conversation with the identity,
                             grouped by person key across all their routing
                             names, from the messages.jsonl index next to the
                             trajectory (derived, self-maintaining; the
                             trajectory stays the source of truth)
  chat history --thread <name> [--since 1d] [-n N] [--json]
                             Every message in that Slack thread, whoever
                             sent it (combine with --with for the union)
  chat pending [--max-age 14d] [--json]
                             Requests the responder deferred to the mind
                             (DEFER) that no observation has resolved yet,
                             oldest first, from the deferrals.jsonl index
                             beside messages.jsonl. The mind delivers one
                             with `chat reply --follow-up --reply-to
                             <trigger> <person>` and closes it with an
                             observation carrying resolves=<trigger>
  chat person-key <name>     Print the stable person key for a routing name
                             (slack-U..-C..-ts -> slack:U..; pwa-x -> pwa:x)
  chat thread-key <name>     Print the thread key (Slack channel threads
                             only; empty for DMs, phone chat, Telegram)
  chat repl                  Interactive chat (shows agent replies inline)

Config file ($CHATRC, default ./.chatrc):
  default_send_from=<name>   Default --from for `chat send`

Environment:
  CHATRC          Path to config file (default: ./.chatrc)
  CHAT_REPEAT_WINDOW  How far back `send`/`reply` look for an identical
                  message to the same destination (default 24h; 0 disables)
  TRAJ_DIR        Trajectory directory (set by `identity shell`)
  TRAJ_ID         Trajectory ID (set by `identity shell`)
  IDENTITY_NAME   Identity name (for reply attribution and --to default)
  IDENTITY_DIR    Identity directory (for repl history)
  MEM_DIR         Memories dir; `type: person` memories with `person_key`
                  and `aliases` merge several keys into one person for
                  history --with
  CHAT_SEND_FILE_MAX_BYTES
                  Max file size for `chat send-file` (default 10485760)
EOF
    exit 0
}

# Dispatch
case "${1:-}" in
    send)      shift; cmd_send "$@" ;;
    send-file) shift; cmd_send_file "$@" ;;
    react)     shift; cmd_react "$@" ;;
    reply)     shift; cmd_reply "$@" ;;
    history) shift; cmd_history "$@" ;;
    pending)   shift; cmd_pending "$@" ;;
    sent)       shift; cmd_sent "$@" ;;
    person-key) shift; cmd_person_key "$@" ;;
    thread-key) shift; cmd_thread_key "$@" ;;
    repl)    shift; cmd_repl "$@" ;;
    -h|--help|help) usage ;;
    "")     usage ;;
    *)      die "Unknown command: $1 (try chat --help)" ;;
esac
